{
  "manifest_version": 3,
  "name": "Support Translator",
  "version": "0.1.0",
  "description": "Перевод сообщений пользователей в окнах тех.поддержки и перевод ответов операторов с подтверждением.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "clipboardWrite"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translation.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/defaults.js",
        "content/core.js",
        "content/incoming.js",
        "content/outgoing.js",
        "content/picker.js",
        "content/main.js"
      ],
      "css": ["content/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Support Translator",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "commands": {
    "translate-input": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Перевести текст в поле ввода (с подтверждением)"
    },
    "retranslate-page": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Перевести окно заново"
    }
  }
}
